# Browser-safe Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Set to true only for an intentional browser-only sample deployment.
# Missing Supabase settings fall back to demo data in development, but fail
# closed with a configuration screen in production.
NEXT_PUBLIC_DEMO_MODE=false

# Server-only settings. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ADMIN_SECRET=replace-with-a-long-random-secret
